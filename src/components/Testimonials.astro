---
import SectionHeading from "./SectionHeading.astro";

// Placeholders de reseñas — reemplazar por comentarios reales de clientes
const reviews = [
  { name: "Cliente 1", text: "Placeholder: comentario del cliente sobre el trabajo realizado.", rating: 5 },
  { name: "Cliente 2", text: "Placeholder: comentario del cliente sobre el trabajo realizado.", rating: 5 },
  { name: "Cliente 3", text: "Placeholder: comentario del cliente sobre el trabajo realizado.", rating: 5 },
];
---
<section id="reseñas" class="bg-cyan-50 py-24">
  <div class="max-w-6xl mx-auto px-6">
    <SectionHeading eyebrow="Reseñas" title="Lo que dicen mis clientes" />
    <div class="grid md:grid-cols-3 gap-6">
      {reviews.map((r) => (
        <div class="reveal bg-white p-6 rounded-2xl shadow-sm">
          <div class="text-cyan-500 mb-3">{"★".repeat(r.rating)}</div>
          <p class="text-carbon-700 text-sm italic">"{r.text}"</p>
          <p class="font-display font-semibold text-carbon-900 mt-4 text-sm">{r.name}</p>
        </div>
      ))}
    </div>
  </div>
</section>