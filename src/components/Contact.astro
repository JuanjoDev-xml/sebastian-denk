---
import Icon from "./Icon.astro";
import CtaButton from "./CtaButton.astro";
const whatsapp = "https://wa.me/5491100000000"; // TODO
---
<section id="contacto" class="bg-carbon-900 py-24">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <span class="font-mono text-sm text-cyan-400 uppercase tracking-wide">Contacto</span>
    <h2 class="font-display text-3xl md:text-4xl font-bold text-white mt-2 mb-6">
      ¿Necesitás un electricista de confianza?
    </h2>
    <p class="text-carbon-400 max-w-md mx-auto mb-8">
      Contame qué necesitás y te respondo a la brevedad con un presupuesto.
    </p>
    <div class="flex justify-center mb-12">
      <CtaButton href={whatsapp} label="Escribir por WhatsApp" />
    </div>

    <!-- 
      Formulario simple, SIN backend por ahora: solo abre el mail del 
      usuario con "mailto:". Para recibir estos mensajes de forma más 
      prolija (sin depender del mail del cliente) más adelante se puede 
      conectar a un servicio como Formspree o Web3Forms, gratis y sin 
      backend propio.
    -->
    <form
      action="mailto:sebastian@ejemplo.com"
      method="POST"
      enctype="text/plain"
      class="reveal grid gap-4 max-w-md mx-auto text-left"
    >
      <input
        type="text"
        name="nombre"
        placeholder="Tu nombre"
        required
        class="rounded-lg px-4 py-3 bg-carbon-700 text-white placeholder-carbon-400 focus:outline-none focus:ring-2 focus:ring-cyan-500"
      />
      <textarea
        name="mensaje"
        placeholder="Contame qué necesitás"
        rows="4"
        required
        class="rounded-lg px-4 py-3 bg-carbon-700 text-white placeholder-carbon-400 focus:outline-none focus:ring-2 focus:ring-cyan-500"
      ></textarea>
      <button
        type="submit"
        class="rounded-full bg-cyan-500 text-carbon-950 font-display font-semibold py-3 hover:bg-cyan-400 transition-colors"
      >
        Enviar mensaje
      </button>
    </form>
  </div>
</section>