---
export interface Props {
  name: "bolt" | "panel" | "clock" | "snowflake" | "shield" | "badge" | "camera" | "map-pin" | "whatsapp" | "lightbulb";
  class?: string;
}
const { name, class: className = "w-6 h-6" } = Astro.props;

// Un ícono = un path (o grupo de paths) de SVG. Los guardamos en un
// objeto para poder elegir cuál mostrar según el prop "name".
const paths: Record<string, string> = {
  bolt: "M13 2 3 14h7l-1 8 10-12h-7l1-8z",
  panel: "M4 4h16v16H4z M4 9h16 M9 4v16 M14 4v16",
  clock: "M12 8v4l3 3 M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z",
  snowflake: "M12 2v20 M4.9 4.9l14.2 14.2 M19.1 4.9 4.9 19.1 M2 12h20",
  shield: "M12 2 4 5v6c0 5 3.5 8.5 8 10 4.5-1.5 8-5 8-10V5l-8-3z",
  badge: "M12 2 4 5v6c0 5 3.5 8.5 8 10 4.5-1.5 8-5 8-10V5l-8-3z M9 12l2 2 4-4",
  camera: "M4 8h3l2-2h6l2 2h3v11H4z M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6z",
  "map-pin": "M12 22s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12z M12 12a2 2 0 1 0 0-4 2 2 0 0 0 0 4z",
  whatsapp: "M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2z M8.5 8.3c.2-.5.4-.5.6-.5h.5c.2 0 .4 0 .6.4l.7 1.7c.1.2 0 .4-.1.6l-.4.5c-.1.2-.2.3 0 .6.6 1 1.5 1.9 2.6 2.4.2.1.4.1.5-.1l.5-.6c.2-.2.3-.2.5-.1l1.5.8c.2.1.3.2.3.4 0 .8-.5 1.6-1.3 1.8-1.6.5-3.6-.3-5.6-2.2-1.6-1.5-2.5-3.1-2.7-4.3-.1-.6 0-1.1.3-1.4z",
  lightbulb: "M9 18h6 M10 21h4 M12 3a6 6 0 0 0-3.6 10.8c.4.3.6.8.6 1.2v.5h6v-.5c0-.4.2-.9.6-1.2A6 6 0 0 0 12 3z",
};
---
<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d={paths[name]} />
</svg>