---
import Icon from "./Icon.astro";

export interface Props {
  href: string;
  label: string;
  variant?: "solid" | "outline" | "light" | "accent";
  icon?: "whatsapp" | "lightbulb" | "facebook";
}
const { href, label, variant = "solid", icon = "whatsapp" } = Astro.props;

const base =
  "group inline-flex items-center gap-2 rounded-full px-6 py-3 font-display font-semibold transition-all duration-300";

// Cada variante define su combinación de fondo/texto en reposo y en hover.
// "light" y "accent" son nuevas: pensadas para usarse sobre fondos oscuros,
// donde "solid" (fondo carbón) se volvía invisible.
const styles = {
  solid: "bg-carbon-900 text-white hover:bg-cyan-600",
  outline: "bg-white text-carbon-900 border border-carbon-900/15 hover:border-cyan-500",
  light: "bg-white text-carbon-900 hover:bg-cyan-500 hover:text-carbon-950",
  accent: "bg-cyan-500 text-carbon-950 hover:bg-cyan-400",
}[variant];
---
<a href={href} class={`${base} ${styles}`}>
  <Icon
    name={icon}
    class={`w-5 h-5 transition-all duration-300 ${
      icon === "lightbulb"
        ? "group-hover:text-cyan-400 group-hover:[filter:drop-shadow(0_0_6px_theme(colors.cyan.400))]"
        : ""
    }`}
  />
  {label}
</a>