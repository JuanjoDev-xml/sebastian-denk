---
export interface Props {
  href: string;
  label: string;
  variant?: "solid" | "outline";
}
const { href, label, variant = "solid" } = Astro.props;

const base =
  "group inline-flex items-center gap-2 rounded-full px-6 py-3 font-display font-semibold transition-all duration-300";
const styles =
  variant === "solid"
    ? "bg-carbon-900 text-white hover:bg-cyan-600"
    : "bg-white text-carbon-900 border border-carbon-900/15 hover:border-cyan-500";
---
<a href={href} class={`${base} ${styles}`}>
  <!-- 
    La lamparita: por defecto tiene stroke gris/blanco (apagada).
    Con "group-hover" (Tailwind detecta el hover del <a> padre gracias 
    a la clase "group" de arriba) le cambiamos el color a cyan y le 
    agregamos un drop-shadow tipo resplandor. Así se siente "encendida".
  -->
  <svg
    class="w-5 h-5 stroke-current transition-all duration-300 group-hover:text-cyan-400 group-hover:[filter:drop-shadow(0_0_6px_theme(colors.cyan.400))]"
    viewBox="0 0 24 24"
    fill="none"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M9 18h6 M10 21h4 M12 3a6 6 0 0 0-3.6 10.8c.4.3.6.8.6 1.2v.5h6v-.5c0-.4.2-.9.6-1.2A6 6 0 0 0 12 3z" />
  </svg>
  {label}
</a>